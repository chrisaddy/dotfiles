layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm"
        }
    }
}

keybinds {
    normal {
        unbind "Ctrl h" "Ctrl n" "Ctrl t" "Ctrl p"
        bind "Ctrl i" { SwitchToMode "pane"; }
        bind "Ctrl m" { SwitchToMode "move"; }
        bind "Ctrl u" { SwitchToMode "resize"; }
        bind "Ctrl Space" { SwitchToMode "tab"; }
    }
    tab {
        bind "Space" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "h" { MoveFocusOrTab "Left"; SwitchToMode "normal"; }
        bind "j" { MoveFocusOrTab "Down"; SwitchToMode "normal"; }
        bind "k" { MoveFocusOrTab "Up"; SwitchToMode "normal"; }
        bind "l" { MoveFocusOrTab "Right"; SwitchToMode "normal"; }
    }
    pane {
        bind "h" { MoveFocus "Left"; SwitchToMode "normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "normal"; }
    }
}

theme "catppuccin-macchiato"
